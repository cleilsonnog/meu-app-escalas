// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// Supondo que você use PostgreSQL (como Supabase, Neon ou local)
datasource db {
  provider = "postgresql"
}

// Tabela de Configurações do Usuário
model UserSettings {
  id            String   @id @default(uuid())
  clerkUserId   String   @unique
  churchName    String
  role          UserRole @default(ADMIN)
  telefoneLider String?
  ministries    Ministry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum UserRole {
  ADMIN
  LEADER
}
// Enum para o status da escala
enum StatusEscala {
  PENDENTE
  CONFIRMADO
  RECUSADO
}

model Ministry {
  id          String      @id @default(uuid())
  clerkUserId String
  nome        String
  descricao   String?
  leaders     Volunteer[] @relation("MinistryLeaders")
  owner       UserSettings @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)
  volunteers  Volunteer[] @relation("VolunteerMinistries")
  escalas     Schedule[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clerkUserId])
}

// Tabela de Voluntários
model Volunteer {
  id                String     @id @default(uuid())
  clerkUserId       String     // Conta administradora dona do registro
  accessClerkUserId String?    @unique // Conta Clerk vinculada ao líder, quando existir
  nome              String
  telefone          String
  email             String?
  departamento      String?
  ativo             Boolean    @default(true)
  ledMinistries     Ministry[] @relation("MinistryLeaders")
  ministries        Ministry[] @relation("VolunteerMinistries")
  escalas           Schedule[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([clerkUserId]) // Melhora a performance ao buscar voluntários por usuário
}

// Tabela de Cultos / Eventos
model Event {
  id          String     @id @default(uuid())
  clerkUserId String     // ID do Líder/Admin dono do culto
  titulo      String     // ex: Culto de Domingo, Culto de Jovens
  dataHora    DateTime
  descricao   String?

  // Relacionamento: Um evento tem várias pessoas escaladas
  escalas     Schedule[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clerkUserId]) // Melhora a performance ao buscar cultos por usuário
}

// Tabela de Escalas (A tabela pivô que une Voluntário e Evento)
model Schedule {
  id          String       @id @default(uuid())
  
  // Chaves estrangeiras
  volunteerId String
  eventId     String
  ministryId  String?

  // Relacionamentos
  volunteer   Volunteer    @relation(fields: [volunteerId], references: [id])
  event       Event        @relation(fields: [eventId], references: [id])
  ministry    Ministry?    @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  funcaoEspecífica String  // ex: Baterista, Câmera 1, Porta Principal
  observacao       String?     // Observações adicionais, se houver
  status      StatusEscala @default(PENDENTE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Garante que a mesma pessoa não seja escalada duas vezes na mesma função no mesmo culto
  @@unique([volunteerId, eventId, funcaoEspecífica])
  @@index([ministryId])
}